# ------------------------------------------------------------------
# Ubuntu deployment settings (optional - defaults are used if unset)
# ------------------------------------------------------------------
# APR upload target for Cleaning_Script.py
APR_SFTP_HOST=172.20.122.231
APR_SFTP_PORT=22
APR_SFTP_USERNAME=
APR_SFTP_PASSWORD=
