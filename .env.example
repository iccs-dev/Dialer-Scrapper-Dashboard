APR_SFTP_REMOTE_BASE=/home/iccsadmin/ishita/APR_Uploads_V2/media/dialer_watch
# APR_SFTP_REMOTE_DIR=   # set to override the full remote path

# Override the project root when the code is deployed outside this folder
# DIALER_SCRAPPER_ROOT=/opt/dialer-scrapper

# Set this only if a specific Chromium build must be used. Left unset,
# Playwright uses the browser it installed under ~/.cache/ms-playwright.
# CHROME_BINARY=/usr/bin/chromium

# ------------------------------------------------------------------
# combine.py - report recipients and process list
# ------------------------------------------------------------------
DIALER_REPORT_RECIPIENTS=
FAILED_AGENT_RECIPIENTS=

# Full production lists (uncomment to restore):
# DIALER_REPORT_RECIPIENTS=ishita.jain@iccs.in,osama.1@iccs.in,trrishan.pareek@iccs.in
# FAILED_AGENT_RECIPIENTS=ishita.jain@iccs.in,suraj.gupta@iccs.in,santosh.kumar@iccs.in,osama.1@iccs.in,trrishan.pareek@iccs.in,manoj.kumar@iccs.in,rahul.kumar@iccs.in,mukesh.gupta@iccs.in

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Processes to include in the summary. Leave unset to auto-discover from the
# media tree; set it to report a fixed list (processes with no data show as 0).
# COMBINE_PROCESSES=ICAI,Imagine,NHDC,TN CM,Amazon Merchant,NHA,Muthoot,IRDAI,KPN,GOQII,DMI,Rlife,MMT Holiday,L&T SME,Edelweiss,Bajaj Capital,ZET,JIO Insurance

# ------------------------------------------------------------------
# Scraper error handling, retries and alerting (core/config.py)
# ------------------------------------------------------------------
ERROR_EMAIL_TO=digx.automation@iccs.in
SCRAPER_MAX_RETRIES=2
SCRAPER_RETRY_BACKOFF=5
SCRAPER_MAX_BROWSER_RESTARTS=1
SCRAPER_MAX_RELOGINS=1
LOG_LEVEL=INFO
TRACE_ON_ERROR=true
SCREENSHOT_ON_ERROR=true
SCRAPER_HEADLESS=true
SCRAPER_ALERTS_ENABLED=true

# Timeouts (milliseconds)
SCRAPER_NAV_TIMEOUT_MS=30000
SCRAPER_ACTION_TIMEOUT_MS=15000
SCRAPER_LOCATOR_TIMEOUT_MS=7000
SCRAPER_DOWNLOAD_TIMEOUT_MS=300000

# ------------------------------------------------------------------
# Smart Dial dialer. <PROCESS> overrides win over the shared value, e.g.
# SMART_DIAL_IMAGINE_USERNAME beats SMART_DIAL_USERNAME.
# ------------------------------------------------------------------
SMART_DIAL_URL=http://172.20.122.100/smart/index.php
SMART_DIAL_IMAGINE_URL=http://172.20.122.100/smart/index.php
SMART_DIAL_IMAGINE_CLIENT_CODE=2737
SMART_DIAL_IMAGINE_USERNAME=
SMART_DIAL_IMAGINE_PASSWORD=

# ICAI runs the same Smart Dial software on its own host.
# NOTE: these are the values carried over from the old Selenium script; the
# dialer currently answers "Invalid Userid or Password!" for them.
SMART_DIAL_ICAI_URL=http://172.20.122.35/smart/login.php
SMART_DIAL_ICAI_CLIENT_CODE=2222
SMART_DIAL_ICAI_USERNAME=
SMART_DIAL_ICAI_PASSWORD=

# ------------------------------------------------------------------
# Django monitoring dashboard
# ------------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,10.140.28.15
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost,http://10.140.28.15
MONITOR_API_TOKEN=
HEARTBEAT_TIMEOUT_SECONDS=90
HEARTBEAT_INTERVAL_SECONDS=30
# Scrapers post here. Pointed straight at Gunicorn rather than through
# Nginx so monitoring keeps working even while the proxy is reloading.
MONITOR_API_URL=http://127.0.0.1:8001

# ------------------------------------------------------------------
# Production web server (stage 7): Nginx on :80 -> Gunicorn on loopback
# ------------------------------------------------------------------
GUNICORN_BIND=127.0.0.1:8001
GUNICORN_LOG_LEVEL=info

# Capped to 1 automatically while CHANNEL_LAYER is the in-memory one: separate
# worker processes cannot share live updates without Redis.
GUNICORN_WORKERS=3

# Redis channel layer. Set to "redis" after installing redis-server; until
# then the in-memory layer runs the site on a single worker.
CHANNEL_LAYER=memory

# collectstatic writes here and Nginx serves it. Left commented until
# deploy/install_stage7.sh creates the directory, which needs root.
#DJANGO_STATIC_ROOT=/var/www/dialer-dashboard/static

# ------------------------------------------------------------------
# DMI. Two dialers feed one report: DMI_b scrapes Smart Dial (same host
# as Imagine, different client code) and DMI_a scrapes OneXVoice. script.py
# runs both and sums Minutes per EmpCode.
# ------------------------------------------------------------------
SMART_DIAL_DMI_URL=http://172.20.122.100/smart/index.php
SMART_DIAL_DMI_CLIENT_CODE=3050
SMART_DIAL_DMI_USERNAME=
SMART_DIAL_DMI_PASSWORD=

ONEXVOICE_URL=https://onexvoice.k8stech.site/telephony/0/dashboard/
ONEXVOICE_USERNAME=
# Note the leading space - it is part of the password as configured on the dialer.
ONEXVOICE_PASSWORD=

# Maps OneXVoice numeric agent ids to ATS employee codes. Without it DMI_a
# cannot produce EmpCodes that HRMS will accept.
DMI_ATS_MAPPING=Media/DMI/ATSIDs.xlsx
\n
# ------------------------------------------------------------------
# Docker Compose (docker-compose.yml). Ignored when running directly
# on the host, where DB_ENGINE stays on its sqlite default.
# ------------------------------------------------------------------
DB_NAME=dialer_dashboard
DB_USER=dialer
DB_PASSWORD=

