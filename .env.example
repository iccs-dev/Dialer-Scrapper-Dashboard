SMART_DIAL_TN_CM_A_CLIENT_CODE=2600
SMART_DIAL_TN_CM_B_CLIENT_CODE=2700
SMART_DIAL_TN_CM_A_USERNAME=
SMART_DIAL_TN_CM_B_USERNAME=
SMART_DIAL_TN_CM_PASSWORD=
